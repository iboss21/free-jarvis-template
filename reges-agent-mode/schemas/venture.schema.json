{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "venture",
  "type": "object",
  "required": ["slug", "state", "autonomy", "budget_usd", "deadline", "kill_criteria"],
  "properties": {
    "slug":        { "type": "string", "maxLength": 64 },
    "state":       { "type": "string", "enum": ["DISCOVERED","RESEARCHING","VALIDATED","BUILDING","LAUNCHED","GROWING","MONETIZING","SCALING","PAUSED","KILLED"] },
    "autonomy":    { "type": "string", "enum": ["L0","L1","L2","L3","L4"] },
    "budget_usd":  { "type": "number", "minimum": 0, "maximum": 1000000 },
    "deadline":    { "type": "string", "maxLength": 32 },
    "rails":       { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 32 } },
    "kill_criteria": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 200 } },
    "policy_warnings": { "type": "integer", "minimum": 0, "maximum": 1000 }
  },
  "additionalProperties": false
}
